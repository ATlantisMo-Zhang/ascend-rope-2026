// Independent correctness runner. All RoPE computation stays in kernel.asc.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../data_utils.h"
#include "../kernel.asc"

#define ACL_CHECK(expr) do { aclError err = (expr); if (err != ACL_SUCCESS) { \
    std::fprintf(stderr, "%s failed: %d\n", #expr, static_cast<int>(err)); return 1; \
} } while (0)
#define FILE_CHECK(expr) do { if (!(expr)) { \
    std::fprintf(stderr, "File I/O failed: %s\n", #expr); return 1; \
} } while (0)

int main(int argc, char** argv)
{
    if (argc != 10) {
        std::fprintf(stderr, "Usage: %s B S H D fp16|fp32 theta x.bin positions.bin y.bin\n", argv[0]);
        return 2;
    }
    const int64_t b = std::atoll(argv[1]);
    const int64_t s = std::atoll(argv[2]);
    const int64_t h = std::atoll(argv[3]);
    const int64_t d = std::atoll(argv[4]);
    const bool fp16 = std::strcmp(argv[5], "fp16") == 0;
    const bool fp32 = std::strcmp(argv[5], "fp32") == 0;
    const float theta = std::strtof(argv[6], nullptr);
    if (b < 1 || b > 128 || s < 1 || s > 8192 || h < 1 || h > 256 ||
        d < 16 || d > 1024 || d % 2 != 0 || (!fp16 && !fp32)) {
        std::fprintf(stderr, "Invalid shape or dtype\n");
        return 2;
    }
    const uint64_t xBytes = static_cast<uint64_t>(b * s) * h * d * (fp16 ? 2 : 4);
    const uint64_t positionsBytes = static_cast<uint64_t>(b * s) * sizeof(int32_t);
    if (xBytes > 256ULL * 1024 * 1024) {
        std::fprintf(stderr, "Validation input exceeds 256 MiB\n");
        return 2;
    }
    int64_t xShape[] = {b, s, h, d};
    int64_t pShape[] = {b, s};
    TensorInfo xTensor[] = {{xShape, 4, fp16 ? 1 : 0}};
    TensorInfo pTensor[] = {{pShape, 2, 5}};
    TensorGroupInfo xInfo = {xTensor, 1};
    TensorGroupInfo pInfo = {pTensor, 1};

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    int64_t coreCount = 0;
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount));
    if (coreCount <= 0) return 1;
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));
    void *xHost = nullptr, *pHost = nullptr, *yHost = nullptr;
    void *xDevice = nullptr, *pDevice = nullptr, *yDevice = nullptr;
    ACL_CHECK(aclrtMallocHost(&xHost, xBytes));
    ACL_CHECK(aclrtMallocHost(&pHost, positionsBytes));
    ACL_CHECK(aclrtMallocHost(&yHost, xBytes));
    ACL_CHECK(aclrtMalloc(&xDevice, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&pDevice, positionsBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&yDevice, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile(argv[7], xBytes, xHost, xBytes));
    FILE_CHECK(ReadFile(argv[8], positionsBytes, pHost, positionsBytes));
    ACL_CHECK(aclrtMemcpy(xDevice, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(pDevice, positionsBytes, pHost, positionsBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    run_kernel((GM_ADDR)xDevice, xInfo, (GM_ADDR)pDevice, pInfo,
        (GM_ADDR)yDevice, xInfo, coreCount, stream, theta);
    ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, 3000));
    ACL_CHECK(aclrtMemcpy(yHost, xBytes, yDevice, xBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile(argv[9], yHost, xBytes));
    std::printf("completed shape=(%lld,%lld,%lld,%lld) dtype=%s vector_cores=%lld\n",
        static_cast<long long>(b), static_cast<long long>(s),
        static_cast<long long>(h), static_cast<long long>(d), argv[5],
        static_cast<long long>(coreCount));

    ACL_CHECK(aclrtFree(yDevice));
    ACL_CHECK(aclrtFree(pDevice));
    ACL_CHECK(aclrtFree(xDevice));
    ACL_CHECK(aclrtFreeHost(yHost));
    ACL_CHECK(aclrtFreeHost(pHost));
    ACL_CHECK(aclrtFreeHost(xHost));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return 0;
}
