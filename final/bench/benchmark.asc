// Measures repeated NPU launches after warmup. No host RoPE computation.
#include <algorithm>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../kernel.asc"

#define ACL_CHECK(expr) do { aclError err = (expr); if (err != ACL_SUCCESS) { \
    std::fprintf(stderr, "%s failed: %d\n", #expr, static_cast<int>(err)); return 1; \
} } while (0)

int main(int argc, char** argv)
{
    if (argc != 7 && argc != 8) {
        std::fprintf(stderr, "Usage: %s B S H D fp16|fp32 repeats [specialPeriod]\n", argv[0]);
        return 2;
    }
    const int64_t b = std::atoll(argv[1]);
    const int64_t s = std::atoll(argv[2]);
    const int64_t h = std::atoll(argv[3]);
    const int64_t d = std::atoll(argv[4]);
    const bool fp16 = argv[5][0] == 'f' && argv[5][1] == 'p' && argv[5][2] == '1' && argv[5][3] == '6' && argv[5][4] == '\0';
    const bool fp32 = argv[5][0] == 'f' && argv[5][1] == 'p' && argv[5][2] == '3' && argv[5][3] == '2' && argv[5][4] == '\0';
    const int repeats = std::atoi(argv[6]);
    int64_t specialPeriod = 0;
    if (argc == 8) {
        char* end = nullptr;
        errno = 0;
        specialPeriod = std::strtoll(argv[7], &end, 10);
        if (errno == ERANGE || end == argv[7] || *end != '\0' || specialPeriod < 0 ||
            (specialPeriod > 0 && !fp16)) {
            std::fprintf(stderr, "specialPeriod must be nonnegative and nonzero only for fp16\n");
            return 2;
        }
    }
    if (b < 1 || b > 128 || s < 1 || s > 8192 || h < 1 || h > 256 ||
        d < 16 || d > 1024 || d % 2 != 0 || (!fp16 && !fp32) ||
        repeats < 1 || repeats > 100) {
        std::fprintf(stderr, "Invalid shape, dtype, or repeats\n");
        return 2;
    }
    const uint64_t tokens = static_cast<uint64_t>(b * s);
    const uint64_t xElements = tokens * static_cast<uint64_t>(h) * static_cast<uint64_t>(d);
    const uint64_t xBytes = xElements * (fp16 ? 2 : 4);
    const uint64_t positionsBytes = tokens * sizeof(int32_t);
    if (xBytes > 256ULL * 1024 * 1024) {
        std::fprintf(stderr, "Benchmark input exceeds 256 MiB\n");
        return 2;
    }

    int64_t xShape[] = {b, s, h, d};
    int64_t pShape[] = {b, s};
    TensorInfo xTensor[] = {{xShape, 4, fp16 ? 1 : 0}};
    TensorInfo pTensor[] = {{pShape, 2, 5}};
    TensorGroupInfo xInfo = {xTensor, 1};
    TensorGroupInfo pInfo = {pTensor, 1};

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    int64_t coreCount = 0;
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount));
    if (coreCount <= 0) {
        std::fprintf(stderr, "No vector cores available\n");
        return 1;
    }
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    void* xHost = nullptr;
    void* pHost = nullptr;
    void* xDevice = nullptr;
    void* pDevice = nullptr;
    void* yDevice = nullptr;
    ACL_CHECK(aclrtMallocHost(&xHost, xBytes));
    ACL_CHECK(aclrtMallocHost(&pHost, positionsBytes));
    ACL_CHECK(aclrtMalloc(&xDevice, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&pDevice, positionsBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&yDevice, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (fp16) {
        auto* values = static_cast<uint16_t*>(xHost);
        for (uint64_t i = 0; i < xElements; ++i) values[i] = 0x3c00;
        if (specialPeriod > 0) {
            const uint16_t specialBits[] = {0x7c00, 0xfc00, 0x7e00, 0x7bff, 0xfbff};
            uint32_t kind = 0;
            for (uint64_t i = 0; i < xElements; i += static_cast<uint64_t>(specialPeriod)) {
                values[i] = specialBits[kind];
                kind = (kind + 1) % 5;
            }
        }
    } else {
        auto* values = static_cast<float*>(xHost);
        for (uint64_t i = 0; i < xElements; ++i) values[i] = 1.0f;
    }
    auto* positions = static_cast<int32_t*>(pHost);
    for (uint64_t i = 0; i < tokens; ++i) positions[i] = static_cast<int32_t>(i % 8192 + 1);
    ACL_CHECK(aclrtMemcpy(xDevice, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(pDevice, positionsBytes, pHost, positionsBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    for (int i = 0; i < 3; ++i) {
        run_kernel((GM_ADDR)xDevice, xInfo,
            (GM_ADDR)pDevice, pInfo,
            (GM_ADDR)yDevice, xInfo, coreCount, stream, 10000.0f);
    }
    ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, 300000));

    std::vector<float> times;
    for (int trial = 0; trial < 5; ++trial) {
        aclrtEvent start = nullptr;
        aclrtEvent end = nullptr;
        ACL_CHECK(aclrtCreateEvent(&start));
        ACL_CHECK(aclrtCreateEvent(&end));
        ACL_CHECK(aclrtRecordEvent(start, stream));
        for (int i = 0; i < repeats; ++i) {
            run_kernel((GM_ADDR)xDevice, xInfo,
                (GM_ADDR)pDevice, pInfo,
                (GM_ADDR)yDevice, xInfo, coreCount, stream, 10000.0f);
        }
        ACL_CHECK(aclrtRecordEvent(end, stream));
        ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, 300000));
        float elapsedMs = 0.0f;
        ACL_CHECK(aclrtEventElapsedTime(&elapsedMs, start, end));
        times.push_back(elapsedMs / repeats);
        ACL_CHECK(aclrtDestroyEvent(start));
        ACL_CHECK(aclrtDestroyEvent(end));
    }
    std::sort(times.begin(), times.end());
    std::printf("shape=(%lld,%lld,%lld,%lld) dtype=%s repeats=%d special_period=%lld median_kernel_ms=%.6f\n",
        static_cast<long long>(b), static_cast<long long>(s),
        static_cast<long long>(h), static_cast<long long>(d),
        fp16 ? "fp16" : "fp32", repeats, static_cast<long long>(specialPeriod), times[2]);

    ACL_CHECK(aclrtFree(yDevice));
    ACL_CHECK(aclrtFree(pDevice));
    ACL_CHECK(aclrtFree(xDevice));
    ACL_CHECK(aclrtFreeHost(pHost));
    ACL_CHECK(aclrtFreeHost(xHost));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return 0;
}
