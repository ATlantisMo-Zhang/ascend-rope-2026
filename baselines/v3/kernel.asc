#include <cstdint>
#include "kernel_operator.h"

// Included by the platform harness; TensorGroupInfo is defined there.
// Host only chooses shapes, dtype and the number of vector cores.

// Compensated FP32 arithmetic keeps the low rounding bits of log/exp.
// Both components are FP32; all of this runs on the NPU scalar unit.
struct RotaryFloatPair { float hi; float lo; };

__aicore__ inline RotaryFloatPair RotaryPairAdd(RotaryFloatPair a, RotaryFloatPair b)
{
    float sum = a.hi + b.hi;
    float part = sum - a.hi;
    float error = (a.hi - (sum - part)) + (b.hi - part);
    error = error + (a.lo + b.lo);
    float hi = sum + error;
    return {hi, error - (hi - sum)};
}

__aicore__ inline RotaryFloatPair RotaryPairMul(RotaryFloatPair a, RotaryFloatPair b)
{
    float product = a.hi * b.hi;
    float splitA = 4097.0f * a.hi;
    float splitB = 4097.0f * b.hi;
    float aHi = splitA - (splitA - a.hi);
    float bHi = splitB - (splitB - b.hi);
    float aLo = a.hi - aHi;
    float bLo = b.hi - bHi;
    float error = ((aHi * bHi - product) + aHi * bLo + aLo * bHi) + aLo * bLo;
    error = error + (a.hi * b.lo + a.lo * b.hi);
    float hi = product + error;
    return {hi, error - (hi - product)};
}

__aicore__ inline RotaryFloatPair RotaryPairDiv(RotaryFloatPair a, RotaryFloatPair b)
{
    float quotient = a.hi / b.hi;
    auto product = RotaryPairMul(b, {quotient, 0.0f});
    auto residual = RotaryPairAdd(a, {-product.hi, -product.lo});
    return RotaryPairAdd({quotient, 0.0f}, {residual.hi / b.hi, 0.0f});
}

__aicore__ inline RotaryFloatPair RotaryLogPair(float value)
{
    union FloatBits { float value; uint32_t bits; } input;
    input.value = value;
    int32_t exponent = static_cast<int32_t>((input.bits >> 23) & 255) - 127;
    uint32_t mantissa = input.bits & 0x7fffff;
    if (exponent == -127) {
        exponent = -126;
        while ((mantissa & 0x800000) == 0) {
            mantissa <<= 1;
            --exponent;
        }
    }
    input.bits = (mantissa & 0x7fffff) | 0x3f800000;
    float normalized = input.value;
    if (normalized > 1.4142135623730951f) {
        normalized *= 0.5f;
        ++exponent;
    }
    // log(m) = 2*(t + t^3/3 + ...), |t| <= 0.172.
    auto numerator = RotaryPairAdd({normalized, 0.0f}, {-1.0f, 0.0f});
    auto denominator = RotaryPairAdd({normalized, 0.0f}, {1.0f, 0.0f});
    auto t = RotaryPairDiv(numerator, denominator);
    auto square = RotaryPairMul(t, t);
    auto term = t;
    auto sum = t;
    for (int32_t n = 3; n <= 21; n += 2) {
        term = RotaryPairMul(term, square);
        sum = RotaryPairAdd(sum, RotaryPairDiv(term, {static_cast<float>(n), 0.0f}));
    }
    const RotaryFloatPair ln2{0.693147182464599609375f, -1.904654323148236e-9f};
    return RotaryPairAdd(RotaryPairMul(sum, {2.0f, 0.0f}),
        RotaryPairMul(ln2, {static_cast<float>(exponent), 0.0f}));
}

__aicore__ inline float RotaryPowerPair(RotaryFloatPair logarithm, float exponent)
{
    auto value = RotaryPairMul(logarithm, {exponent, 0.0f});
    int32_t scaleExponent = static_cast<int32_t>(value.hi * 1.4426950408889634f +
        (value.hi >= 0.0f ? 0.5f : -0.5f));
    const RotaryFloatPair minusLn2{-0.693147182464599609375f, 1.904654323148236e-9f};
    auto reduced = RotaryPairAdd(value,
        RotaryPairMul(minusLn2, {static_cast<float>(scaleExponent), 0.0f}));
    // exp(r) = sum(r^n/n!), |r| <= log(2)/2.
    RotaryFloatPair sum{1.0f, 0.0f}, term{1.0f, 0.0f};
    for (int32_t n = 1; n <= 14; ++n) {
        term = RotaryPairDiv(RotaryPairMul(term, reduced), {static_cast<float>(n), 0.0f});
        sum = RotaryPairAdd(sum, term);
    }
    float result = sum.hi + sum.lo;
    union FloatBits { uint32_t bits; float value; } scale;
    if (scaleExponent > 127) {
        scaleExponent -= 1;
        result *= 2.0f;
    }
    if (scaleExponent < -126) {
        scale.bits = static_cast<uint32_t>(scaleExponent + 253) << 23;
        result *= scale.value;
        scaleExponent = -126;
    }
    scale.bits = static_cast<uint32_t>(scaleExponent + 127) << 23;
    return result * scale.value;
}

__aicore__ inline float RotaryReduceAngle(float value)
{
    union FloatBits { float value; uint32_t bits; } input;
    input.value = value;
    bool negative = (input.bits & 0x80000000) != 0;
    input.bits &= 0x7fffffff;
    value = input.value;
    if (value <= 131072.0f) {
        // Split 2*pi: both leading products are exact over the normal RoPE range.
        int32_t turns = static_cast<int32_t>(value * 0.15915494309189535f + 0.5f);
        float reduced = value - static_cast<float>(turns) * 6.28125f;
        reduced = reduced - static_cast<float>(turns) * 0.001934051513671875f;
        reduced = reduced - static_cast<float>(turns) * 0.0000012556659143567085f;
        return negative ? -reduced : reduced;
    }

    // theta has no lower bound in the statement. For large finite FP32 angles,
    // use integer Payne-Hanek reduction instead of overflowing the turn count.
    uint32_t exponent = (input.bits >> 23) & 255;
    if (exponent == 255) {
        return 0.0f; // Non-finite angles get NaN cos/sin after the bounded API calls.
    }
    uint32_t mantissa = (input.bits & 0x7fffff) | 0x800000;
    // floor((2/pi) * 2^192), least-significant word first.
    const uint32_t twoOverPi[6] = {0x3c439041, 0xdb629599, 0xf534ddc0,
        0xfc2757d1, 0x4e441529, 0xa2f9836e};
    uint32_t product[7];
    uint64_t carry = 0;
    for (uint32_t i = 0; i < 6; ++i) {
        uint64_t part = static_cast<uint64_t>(mantissa) * twoOverPi[i] + carry;
        product[i] = static_cast<uint32_t>(part);
        carry = part >> 32;
    }
    product[6] = static_cast<uint32_t>(carry);
    // value * (2/pi) = product / 2^(215 - unbiasedExponent).
    uint32_t shift = 342 - exponent;
    uint32_t word = shift / 32;
    uint32_t bit = shift % 32;
    uint64_t quotientBits = product[word];
    if (word < 6) {
        quotientBits |= static_cast<uint64_t>(product[word + 1]) << 32;
    }
    uint32_t quadrant = static_cast<uint32_t>(quotientBits >> bit) & 3;
    word = (shift - 32) / 32;
    bit = (shift - 32) % 32;
    uint64_t fractionBits = product[word] | (static_cast<uint64_t>(product[word + 1]) << 32);
    uint32_t fraction = static_cast<uint32_t>(fractionBits >> bit);
    if (fraction & 0x80000000) {
        quadrant = (quadrant + 1) & 3;
    }
    // Device scalar conversion supports signed int32, not uint32.
    float remainder = static_cast<float>(static_cast<int32_t>(fraction)) * 2.3283064365386962890625e-10f;
    remainder *= 1.5707963267948966f;
    if (quadrant == 1) {
        remainder += 1.5707963267948966f;
    } else if (quadrant == 2) {
        remainder += remainder >= 0.0f ? -3.1415926535897932f : 3.1415926535897932f;
    } else if (quadrant == 3) {
        remainder -= 1.5707963267948966f;
    }
    return negative ? -remainder : remainder;
}

__aicore__ inline uint16_t RotaryHalfSpecialBits(float value)
{
    union FloatBits { float value; uint32_t bits; } input;
    input.value = value;
    uint32_t magnitude = input.bits & 0x7fffffff;
    uint16_t sign = static_cast<uint16_t>((input.bits >> 16) & 0x8000);
    if (magnitude > 0x7f800000) {
        return sign | 0x7e00; // Quiet NaN.
    }
    if (magnitude >= 0x477ff000) {
        return sign | 0x7c00; // 65520 and larger round to infinity in FP16.
    }
    return 0; // Ordinary finite values use vector Cast.
}

__aicore__ inline void RotaryLoadFloat(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::Adds(dst, src, 0.0f, count);
}

__aicore__ inline void RotaryLoadFloat(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<half>& src, uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

__aicore__ inline void RotaryStoreFloat(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::Adds(dst, src, 0.0f, count);
}

__aicore__ inline void RotaryStoreFloat(const AscendC::LocalTensor<half>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_RINT, count);
}

template <typename T>
class RotaryPosEmbBaseline {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
        uint64_t tokenCount, uint32_t heads, uint32_t dim, uint32_t tokensPerGroup)
    {
        heads_ = heads;
        dim_ = dim;
        halfDim_ = dim / 2;
        // Both float and half slices start at 32-byte aligned UB addresses.
        pitch_ = (halfDim_ + 15) / 16 * 16;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), tokenCount * heads * dim);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), tokenCount * heads * dim);
        positionsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(positions), tokenCount);

        // Contiguous groups keep different cores' output regions 32-byte aligned.
        uint64_t groups = (tokenCount + tokensPerGroup - 1) / tokensPerGroup;
        uint64_t firstGroup = groups * AscendC::GetBlockIdx() / AscendC::GetBlockNum();
        uint64_t lastGroup = groups * (AscendC::GetBlockIdx() + 1) / AscendC::GetBlockNum();
        firstToken_ = firstGroup * tokensPerGroup;
        lastToken_ = lastGroup * tokensPerGroup;
        if (lastToken_ > tokenCount) {
            lastToken_ = tokenCount;
        }

        pipe_.InitBuffer(inputQueue_, 1, 2 * pitch_ * sizeof(T));
        pipe_.InitBuffer(outputQueue_, 1, 2 * pitch_ * sizeof(T));
        pipe_.InitBuffer(workBuffer_, 9 * pitch_ * sizeof(float));
        // Power/Sin/Cos use framework-managed temporary space in the remaining UB.
    }

    __aicore__ inline void Process(float theta)
    {
        auto work = workBuffer_.Get<float>();
        auto invFreq = work;
        auto angle = work[pitch_];
        auto cosine = work[2 * pitch_];
        auto sine = work[3 * pitch_];
        auto first = work[4 * pitch_];
        auto second = work[5 * pitch_];
        auto product = work[6 * pitch_];
        auto rotatedFirst = work[7 * pitch_];
        auto rotatedSecond = work[8 * pitch_];

        // Long positions magnify a few ULPs in the generic Power API.
        // Compute the positive finite base with compensated FP32 log/exp,
        // round the power to FP32, then take the FP32 reciprocal like golden.
        if (theta > 0.0f && theta <= 3.4028234663852886e38f) {
            auto logarithm = RotaryLogPair(theta);
            for (uint32_t i = 0; i < halfDim_; ++i) {
                float exponent = static_cast<float>(static_cast<int32_t>(2 * i)) /
                    static_cast<float>(static_cast<int32_t>(dim_));
                invFreq.SetValue(i, 1.0f / RotaryPowerPair(logarithm, exponent));
            }
        } else {
            for (uint32_t i = 0; i < pitch_; ++i) {
                angle.SetValue(i, i < halfDim_ ? static_cast<float>(static_cast<int32_t>(2 * i)) /
                    static_cast<float>(static_cast<int32_t>(dim_)) : 0.0f);
            }
            Sync<AscendC::HardEvent::S_V>();
            AscendC::Power<float, false>(invFreq, theta, angle, pitch_);
            Sync<AscendC::HardEvent::V_S>();
            for (uint32_t i = 0; i < halfDim_; ++i) {
                invFreq.SetValue(i, 1.0f / invFreq.GetValue(i));
            }
        }

        for (uint64_t token = firstToken_; token < lastToken_; ++token) {
            int32_t position = positionsGm_.GetValue(token);
            if (position != 0) {
                // Finish prior vector reads before scalar writes reuse angle.
                Sync<AscendC::HardEvent::V_S>();
                bool hasNonFiniteAngle = false;
                for (uint32_t i = 0; i < pitch_; ++i) {
                    float value = i < halfDim_ ? static_cast<float>(position) * invFreq.GetValue(i) : 0.0f;
                    hasNonFiniteAngle = hasNonFiniteAngle || !(value <= 3.4028234663852886e38f && value >= -3.4028234663852886e38f);
                    angle.SetValue(i, RotaryReduceAngle(value));
                }
                Sync<AscendC::HardEvent::S_V>();
                AscendC::Cos<float, false>(cosine, angle, pitch_);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Sin<float, false>(sine, angle, pitch_);
                AscendC::PipeBarrier<PIPE_V>();
                if (hasNonFiniteAngle) {
                    Sync<AscendC::HardEvent::V_S>();
                    union FloatBits { uint32_t bits; float value; } nanValue;
                    nanValue.bits = 0x7fc00000;
                    for (uint32_t i = 0; i < halfDim_; ++i) {
                        float value = static_cast<float>(position) * invFreq.GetValue(i);
                        if (!(value <= 3.4028234663852886e38f && value >= -3.4028234663852886e38f)) {
                            cosine.SetValue(i, nanValue.value);
                            sine.SetValue(i, nanValue.value);
                        }
                    }
                    Sync<AscendC::HardEvent::S_V>();
                }
            }

            for (uint32_t head = 0; head < heads_; ++head) {
                uint64_t offset = (token * heads_ + head) * dim_;
                AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(halfDim_ * sizeof(T)), 0, 0, 0};
                uint8_t padding = static_cast<uint8_t>((32 - halfDim_ * sizeof(T) % 32) % 32 / sizeof(T));
                AscendC::DataCopyPadExtParams<T> padParams{true, 0, padding, static_cast<T>(0)};
                auto input = inputQueue_.template AllocTensor<T>();
                AscendC::DataCopyPad(input, xGm_[offset], copyParams, padParams);
                AscendC::DataCopyPad(input[pitch_], xGm_[offset + halfDim_], copyParams, padParams);
                inputQueue_.EnQue(input);
                input = inputQueue_.template DeQue<T>();
                auto output = outputQueue_.template AllocTensor<T>();

                if (position == 0) {
                    // Exact identity, including signed zero and NaN/Inf payloads.
                    AscendC::DataCopy(output, input, 2 * pitch_);
                } else {
                    RotaryLoadFloat(first, input, halfDim_);
                    RotaryLoadFloat(second, input[pitch_], halfDim_);
                    AscendC::PipeBarrier<PIPE_V>();
                    // Pair i in the first half with i in the second half.
                    AscendC::Mul(product, second, sine, halfDim_);
                    AscendC::Mul(rotatedFirst, first, cosine, halfDim_);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Sub(rotatedFirst, rotatedFirst, product, halfDim_);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(product, first, sine, halfDim_);
                    AscendC::Mul(rotatedSecond, second, cosine, halfDim_);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(rotatedSecond, rotatedSecond, product, halfDim_);
                    AscendC::PipeBarrier<PIPE_V>();
                    RotaryStoreFloat(output, rotatedFirst, halfDim_);
                    RotaryStoreFloat(output[pitch_], rotatedSecond, halfDim_);
                    if (sizeof(T) == sizeof(half)) {
                        // CANN 9.0 lacks Get/SetSaturationFlag. Restore only the
                        // special FP16 encodings after the ordinary vector Cast.
                        Sync<AscendC::HardEvent::V_S>();
                        auto outputBits = output.template ReinterpretCast<uint16_t>();
                        for (uint32_t i = 0; i < halfDim_; ++i) {
                            uint16_t firstBits = RotaryHalfSpecialBits(rotatedFirst.GetValue(i));
                            uint16_t secondBits = RotaryHalfSpecialBits(rotatedSecond.GetValue(i));
                            if (firstBits != 0) {
                                outputBits.SetValue(i, firstBits);
                            }
                            if (secondBits != 0) {
                                outputBits.SetValue(pitch_ + i, secondBits);
                            }
                        }
                        Sync<AscendC::HardEvent::S_V>();
                    }
                }
                outputQueue_.EnQue(output);
                inputQueue_.FreeTensor(input);
                output = outputQueue_.template DeQue<T>();
                // Only the valid bytes are written; UB padding never reaches GM.
                AscendC::DataCopyPad(yGm_[offset], output, copyParams);
                AscendC::DataCopyPad(yGm_[offset + halfDim_], output[pitch_], copyParams);
                outputQueue_.FreeTensor(output);
            }
        }
        Sync<AscendC::HardEvent::V_S>();
    }

private:
    template <AscendC::HardEvent event>
    __aicore__ inline void Sync()
    {
        int32_t eventId = static_cast<int32_t>(pipe_.FetchEventID(event));
        AscendC::SetFlag<event>(eventId);
        AscendC::WaitFlag<event>(eventId);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuffer_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::GlobalTensor<int32_t> positionsGm_;
    uint64_t firstToken_, lastToken_;
    uint32_t heads_, dim_, halfDim_, pitch_;
};

template <typename T>
__global__ __vector__ void rotary_pos_emb_custom(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokenCount, uint32_t heads, uint32_t dim, uint32_t tokensPerGroup, float theta)
{
    RotaryPosEmbBaseline<T> op;
    op.Init(x, positions, y, tokenCount, heads, dim, tokensPerGroup);
    op.Process(theta);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR positions,
    const TensorGroupInfo& info_positions, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, float theta)
{
    uint64_t tokenCount = static_cast<uint64_t>(info_x.tensors[0].shape[0]) * info_x.tensors[0].shape[1];
    uint32_t heads = static_cast<uint32_t>(info_x.tensors[0].shape[2]);
    uint32_t dim = static_cast<uint32_t>(info_x.tensors[0].shape[3]);
    uint32_t elementBytes = info_x.tensors[0].dtype == 1 ? 2 : 4;
    uint32_t tokensPerGroup = 1;
    while ((static_cast<uint64_t>(tokensPerGroup) * heads * dim * elementBytes) % 32 != 0) {
        ++tokensPerGroup;
    }
    uint64_t groups = (tokenCount + tokensPerGroup - 1) / tokensPerGroup;
    uint32_t blockNum = static_cast<uint32_t>(groups < static_cast<uint64_t>(availableCoreNum) ? groups : availableCoreNum);
    if (info_x.tensors[0].dtype == 1) {
        rotary_pos_emb_custom<half><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
    } else {
        rotary_pos_emb_custom<float><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
    }
}
