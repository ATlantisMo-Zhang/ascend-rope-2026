}

template <AscendC::HardEvent event>
__aicore__ inline void RotaryStaticSync()
{
    AscendC::SetFlag<event>(EVENT_ID0);
    AscendC::WaitFlag<event>(EVENT_ID0);
}

__aicore__ inline void RotaryStaticInitBaseline(float theta, uint32_t dim_, uint32_t halfDim_, uint32_t pitch_,
    const AscendC::LocalTensor<float>& invFreq)
{
        // Long positions magnify a few ULPs in the generic Power API.
        // Compute the positive finite base with compensated FP32 log/exp,
        // round the power to FP32, then take the FP32 reciprocal like golden.
        if (theta == 1.0f) {
            // Runtime theta is exactly one, so every reciprocal power equals it.
            AscendC::Duplicate(invFreq, theta, pitch_);
            RotaryStaticSync<AscendC::HardEvent::V_S>();
        } else if (theta > 0.0f && theta <= 3.4028234663852886e38f) {
            auto logarithm = RotaryThetaLogPair(theta);
            if (theta >= 1.0f && theta <= 1.0e8f && (dim_ & (dim_ - 1)) == 0) {
                RotaryFloatPair ratio;
                RotaryPowerPair(logarithm,
                    2.0f / static_cast<float>(static_cast<int32_t>(dim_)), &ratio);
                RotaryFloatPair power{1.0f, 0.0f};
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    if (i != 0) power = RotaryPairMul(power, ratio);
                    invFreq.SetValue(i, 1.0f / (power.hi + power.lo));
                }
            } else if (theta >= 1.0f && theta <= 1.0e8f) {
                float cachedSteps[16];
                RotaryFloatPair cachedRatios[16];
                uint32_t cachedCount = 0;
                RotaryFloatPair power{1.0f, 0.0f};
                float previousExponent = 0.0f;
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    float exponent = static_cast<float>(static_cast<int32_t>(2 * i)) /
                        static_cast<float>(static_cast<int32_t>(dim_));
                    if (i != 0) {
                        float step = exponent - previousExponent;
                        uint32_t cached = 0;
                        while (cached < cachedCount && cachedSteps[cached] != step) ++cached;
                        if (cached == cachedCount) {
                            if (cachedCount != 0) {
                                cachedRatios[cached] = RotaryRatioDelta(logarithm, step,
                                    cachedSteps[0], cachedRatios[0]);
                            } else {
                                RotaryPowerPair(logarithm, step, &cachedRatios[cached]);
                            }
                            cachedSteps[cached] = step;
                            ++cachedCount;
                        }
                        power = RotaryPairMul(power, cachedRatios[cached]);
                    }
                    invFreq.SetValue(i, 1.0f / (power.hi + power.lo));
                    previousExponent = exponent;
                }
            } else {
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    float exponent = static_cast<float>(static_cast<int32_t>(2 * i)) /
                        static_cast<float>(static_cast<int32_t>(dim_));
                    invFreq.SetValue(i, 1.0f / RotaryPowerPair(logarithm, exponent));
                }
            }
        }
}

__aicore__ inline void RotaryStaticInitHorner(float theta, uint32_t dim_, uint32_t halfDim_, uint32_t pitch_,
    const AscendC::LocalTensor<float>& invFreq)
{
        // Long positions magnify a few ULPs in the generic Power API.
        // Compute the positive finite base with compensated FP32 log/exp,
        // round the power to FP32, then take the FP32 reciprocal like golden.
        if (theta > 0.0f && theta <= 3.4028234663852886e38f) {
            auto logarithm = RotaryThetaLogPair(theta);
            if (theta >= 1.0f && theta <= 1.0e8f && (dim_ & (dim_ - 1)) == 0) {
                RotaryFloatPair ratio;
                RotaryPowerPairHornerIsolated(logarithm,
                    2.0f / static_cast<float>(static_cast<int32_t>(dim_)), &ratio, true);
                RotaryFloatPair power{1.0f, 0.0f};
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    if (i != 0) power = RotaryPairMul(power, ratio);
                    invFreq.SetValue(i, 1.0f / (power.hi + power.lo));
                }
            } else if (theta >= 1.0f && theta <= 1.0e8f) {
                bool useHorner = theta == 10000.0f;
                float cachedSteps[16];
                RotaryFloatPair cachedRatios[16];
                uint32_t cachedCount = 0;
                RotaryFloatPair power{1.0f, 0.0f};
                float previousExponent = 0.0f;
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    float exponent = static_cast<float>(static_cast<int32_t>(2 * i)) /
                        static_cast<float>(static_cast<int32_t>(dim_));
                    if (i != 0) {
                        float step = exponent - previousExponent;
                        uint32_t cached = 0;
                        while (cached < cachedCount && cachedSteps[cached] != step) ++cached;
                        if (cached == cachedCount) {
                            if (useHorner && cachedCount != 0) {
                                cachedRatios[cached] = RotaryRatioDelta(logarithm, step,
                                    cachedSteps[0], cachedRatios[0]);
                            } else {
                                RotaryPowerPairHornerIsolated(logarithm, step, &cachedRatios[cached], useHorner);
                            }
                            cachedSteps[cached] = step;
                            ++cachedCount;
                        }
                        power = RotaryPairMul(power, cachedRatios[cached]);
                    }
                    invFreq.SetValue(i, 1.0f / (power.hi + power.lo));
                    previousExponent = exponent;
                }
            } else {
                for (uint32_t i = 0; i < halfDim_; ++i) {
                    float exponent = static_cast<float>(static_cast<int32_t>(2 * i)) /
                        static_cast<float>(static_cast<int32_t>(dim_));
                    invFreq.SetValue(i, 1.0f / RotaryPowerPairHornerIsolated(logarithm, exponent));
                }
            }
        }
}


template <bool Horner>
__global__ __vector__ void rotary_static_short(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokenCount, uint32_t heads, uint32_t dim, uint32_t tokensPerGroup, float theta)
{
    AscendC::InitSocState();
    const uint32_t halfDim = dim / 2;
    const uint32_t pitch = (halfDim + 15) / 16 * 16;
    AscendC::LocalTensor<float> work(AscendC::TPosition::VECCALC, 0, 9 * pitch);
    AscendC::LocalTensor<float> input(AscendC::TPosition::VECIN, 9 * pitch * sizeof(float), 2 * pitch);
    AscendC::LocalTensor<float> output(AscendC::TPosition::VECOUT, 11 * pitch * sizeof(float), 2 * pitch);
    AscendC::GlobalTensor<float> xGm, yGm;
    AscendC::GlobalTensor<int32_t> positionsGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), tokenCount * dim);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), tokenCount * dim);
    positionsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(positions), tokenCount);
    uint64_t firstToken = tokenCount * AscendC::GetBlockIdx() / AscendC::GetBlockNum();
    uint64_t lastToken = tokenCount * (AscendC::GetBlockIdx() + 1) / AscendC::GetBlockNum();
    auto invFreq = work;
    if (Horner) RotaryStaticInitHorner(10000.0f, dim, halfDim, pitch, invFreq);
    else RotaryStaticInitBaseline(theta, dim, halfDim, pitch, invFreq);
    for (uint32_t i = halfDim; i < pitch; ++i) invFreq.SetValue(i, 0.0f);
    RotaryStaticSync<AscendC::HardEvent::S_V>();
    auto angle = work[pitch];
    auto cosine = work[2 * pitch];
    auto sine = work[3 * pitch];
    auto first = work[4 * pitch];
    auto second = work[5 * pitch];
    auto product = work[6 * pitch];
    auto rotatedFirst = work[7 * pitch];
    auto rotatedSecond = work[8 * pitch];
    const uint32_t blockBytes = halfDim * sizeof(float);
    AscendC::DataCopyExtParams copyParams{1, blockBytes, 0, 0, 0};
    AscendC::DataCopyPadExtParams<float> padParams{true, 0, 0, 0.0f};
    for (uint64_t token = firstToken; token < lastToken; ++token) {
        int32_t position = positionsGm.GetValue(token);
        if (position != 0) {
            RotaryStaticSync<AscendC::HardEvent::V_S>();
            RotaryStaticSync<AscendC::HardEvent::S_V>();
            AscendC::Muls(angle, invFreq, static_cast<float>(position), pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(first, angle, 0.15915494309189535f, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(first, first, 0.5f, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(second, first, AscendC::RoundMode::CAST_FLOOR, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(product, second, 6.28125f, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angle, angle, product, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(product, second, 0.001934051513671875f, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angle, angle, product, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(product, second, 0.0000012556659143567085f, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angle, angle, product, pitch);
            AscendC::PipeBarrier<PIPE_V>();
            RotaryPackedSdkTrig(cosine, sine, angle, pitch);
        }
        uint64_t offset = token * dim;
        AscendC::DataCopyPad(input, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(input[pitch], xGm[offset + halfDim], copyParams, padParams);
        RotaryStaticSync<AscendC::HardEvent::MTE2_V>();
        if (position == 0) {
            AscendC::DataCopy(output, input, 2 * pitch);
        } else {
            RotaryLoadFloat(first, input, halfDim);
            RotaryLoadFloat(second, input[pitch], halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(product, second, sine, halfDim);
            AscendC::Mul(rotatedFirst, first, cosine, halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(rotatedFirst, rotatedFirst, product, halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(product, first, sine, halfDim);
            AscendC::Mul(rotatedSecond, second, cosine, halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(rotatedSecond, rotatedSecond, product, halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            RotaryStoreFloat(output, rotatedFirst, halfDim);
            RotaryStoreFloat(output[pitch], rotatedSecond, halfDim);
        }
        RotaryStaticSync<AscendC::HardEvent::V_MTE2>();
        RotaryStaticSync<AscendC::HardEvent::V_MTE3>();
        AscendC::DataCopyPad(yGm[offset], output, copyParams);
        AscendC::DataCopyPad(yGm[offset + halfDim], output[pitch], copyParams);
        RotaryStaticSync<AscendC::HardEvent::MTE3_V>();
    }
    RotaryStaticSync<AscendC::HardEvent::V_S>();
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <bool Horner>
class RotaryHalfTokenWindow {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
        uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t rows)
    {
        heads_ = heads; dim_ = dim; halfDim_ = dim / 2;
        pitch_ = (halfDim_ + 15) / 16 * 16; rows_ = rows;
        first_ = tokens * AscendC::GetBlockIdx() / AscendC::GetBlockNum();
        last_ = tokens * (AscendC::GetBlockIdx() + 1) / AscendC::GetBlockNum();
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x), tokens * heads * dim);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), tokens * heads * dim);
        positions_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(positions), tokens);
        const uint32_t elements = rows_ * heads_ * dim_;
        pipe_.InitBuffer(input_, 2, elements * sizeof(half));
        pipe_.InitBuffer(output_, 2, elements * sizeof(half));
        pipe_.InitBuffer(frequency_, pitch_ * sizeof(float));
        pipe_.InitBuffer(trig_, 5 * rows_ * pitch_ * sizeof(float));
        // AoS float values plus two half-sized products. Raw half input stays live.
        pipe_.InitBuffer(values_, 2 * elements * sizeof(float));
    }
    __aicore__ inline void Process(float theta)
    {
        auto frequency = frequency_.Get<float>();
        if (Horner) RotaryStaticInitHorner(10000.0f, dim_, halfDim_, pitch_, frequency);
        else RotaryStaticInitBaseline(theta, dim_, halfDim_, pitch_, frequency);
        for (uint32_t i = halfDim_; i < pitch_; ++i) frequency.SetValue(i, 0.0f);
        Sync<AscendC::HardEvent::S_V>();
        for (uint64_t token = first_; token < last_; token += rows_) {
            const uint32_t rows = last_ - token < rows_ ? static_cast<uint32_t>(last_ - token) : rows_;
            const uint32_t trigCount = rows * pitch_;
            auto angles = trig_.Get<float>();
            auto cosine = angles[trigCount];
            auto sine = angles[2 * trigCount];
            auto turns = angles[3 * trigCount];
            auto temporary = angles[4 * trigCount];
            uint32_t zeros = 0;
            for (uint32_t row = 0; row < rows; ++row) {
                const int32_t position = positions_.GetValue(token + row);
                if (position == 0) zeros |= 1u << row;
                AscendC::Muls(angles[row * pitch_], frequency, static_cast<float>(position), pitch_);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, angles, 0.15915494309189535f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(temporary, temporary, 0.5f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(turns, temporary, AscendC::RoundMode::CAST_FLOOR, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 6.28125f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 0.001934051513671875f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 0.0000012556659143567085f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            RotarySharedHalfTrig(cosine, sine, angles, turns, temporary, trigCount);
            auto negativeSine = angles;
            if (heads_ > 1) {
                AscendC::Muls(negativeSine, sine, -1.0f, trigCount);
                AscendC::PipeBarrier<PIPE_V>();
            }
            const uint32_t elements = rows * heads_ * dim_;
            const uint32_t pairs = elements / 2;
            const uint64_t offset = token * heads_ * dim_;
            AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(elements * sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<half> pad{true, 0, 0, static_cast<half>(0)};
            auto input = input_.template AllocTensor<half>();
            AscendC::DataCopyPad(input, x_[offset], copy, pad);
            input_.EnQue(input);
            input = input_.template DeQue<half>();
            auto output = output_.template AllocTensor<half>();
            auto values = values_.Get<float>();
            auto positive = values[elements];
            auto negative = values[elements + pairs];
            RotaryLoadFloat(values, input, elements);
            AscendC::PipeBarrier<PIPE_V>();
            const uint8_t dataStride = static_cast<uint8_t>(heads_ * dim_ / 8);
            const uint8_t productStride = static_cast<uint8_t>(heads_ * halfDim_ / 8);
            const uint8_t trigStride = static_cast<uint8_t>(pitch_ / 8);
            AscendC::BinaryRepeatParams products{1, 1, 1, productStride, dataStride, trigStride};
            AscendC::BinaryRepeatParams multiply{1, 1, 1, dataStride, dataStride, trigStride};
            AscendC::BinaryRepeatParams fma{1, 1, 1, dataStride, trigStride, productStride};
            AscendC::BinaryRepeatParams add{1, 1, 1, dataStride, dataStride, productStride};
            for (uint32_t head = 0; head < heads_; ++head) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    const uint32_t data = head * dim_ + start;
                    const uint32_t product = head * halfDim_ + start;
                    AscendC::Mul(positive[product], values[data], sine[start], length,
                        static_cast<uint8_t>(rows), products);
                    AscendC::Mul(negative[product], values[data + halfDim_],
                        heads_ > 1 ? negativeSine[start] : sine[start], length,
                        static_cast<uint8_t>(rows), products);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t head = 0; head < heads_; ++head) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    const uint32_t data = head * dim_ + start;
                    const uint32_t product = head * halfDim_ + start;
                    if (heads_ > 1) {
                        AscendC::FusedMulAdd(values[data], cosine[start], negative[product], length,
                            static_cast<uint8_t>(rows), fma);
                        AscendC::FusedMulAdd(values[data + halfDim_], cosine[start], positive[product], length,
                            static_cast<uint8_t>(rows), fma);
                    } else {
                        AscendC::Mul(values[data], values[data], cosine[start], length,
                            static_cast<uint8_t>(rows), multiply);
                        AscendC::Mul(values[data + halfDim_], values[data + halfDim_], cosine[start], length,
                            static_cast<uint8_t>(rows), multiply);
                    }
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (heads_ == 1) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    AscendC::Sub(values[start], values[start], negative[start], length,
                        static_cast<uint8_t>(rows), add);
                    AscendC::Add(values[start + halfDim_], values[start + halfDim_], positive[start], length,
                        static_cast<uint8_t>(rows), add);
                }
                AscendC::PipeBarrier<PIPE_V>();
            }
            RotaryStoreFloat(output, values, elements);
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t row = 0; row < rows; ++row) {
                if (zeros & (1u << row)) {
                    const uint32_t begin = row * heads_ * dim_;
                    AscendC::DataCopy(output[begin], input[begin], heads_ * dim_);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            output_.EnQue(output);
            input_.FreeTensor(input);
            output = output_.template DeQue<half>();
            AscendC::DataCopyPad(y_[offset], output, copy);
            output_.FreeTensor(output);
        }
        Sync<AscendC::HardEvent::V_S>();
    }
private:
    template <AscendC::HardEvent event>
    __aicore__ inline void Sync()
    {
        int32_t id = static_cast<int32_t>(pipe_.FetchEventID(event));
        AscendC::SetFlag<event>(id); AscendC::WaitFlag<event>(id);
    }
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> output_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> frequency_, trig_, values_;
    AscendC::GlobalTensor<half> x_, y_;
    AscendC::GlobalTensor<int32_t> positions_;
    uint64_t first_, last_;
    uint32_t heads_, dim_, halfDim_, pitch_, rows_;
};

template <bool Horner>
__global__ __vector__ void rotary_half_token_window(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t rows, float theta)
{
    RotaryHalfTokenWindow<Horner> op;
    constexpr uint64_t nonSaturatingFloat = uint64_t(1) << 48;
    const uint64_t oldCtrl = get_ctrl();
    const bool changeMode = (oldCtrl & nonSaturatingFloat) == 0;
    if (changeMode) {
        AscendC::PipeBarrier<PIPE_ALL>(); set_ctrl(oldCtrl | nonSaturatingFloat);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
    op.Init(x, positions, y, tokens, heads, dim, rows);
    op.Process(Horner ? 10000.0f : theta);
    if (changeMode) {
        AscendC::PipeBarrier<PIPE_ALL>();
        set_ctrl((get_ctrl() & ~nonSaturatingFloat) | (oldCtrl & nonSaturatingFloat));
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

template <bool Horner>
class RotaryFloatTokenWindow {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
        uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t rows)
    {
        heads_ = heads; dim_ = dim; halfDim_ = dim / 2;
        pitch_ = (halfDim_ + 15) / 16 * 16; rows_ = rows;
        first_ = tokens * AscendC::GetBlockIdx() / AscendC::GetBlockNum();
        last_ = tokens * (AscendC::GetBlockIdx() + 1) / AscendC::GetBlockNum();
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), tokens * heads * dim);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), tokens * heads * dim);
        positions_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(positions), tokens);
        const uint32_t elements = rows_ * heads_ * dim_;
        pipe_.InitBuffer(input_, 2, elements * sizeof(float));
        pipe_.InitBuffer(output_, 2, elements * sizeof(float));
        pipe_.InitBuffer(frequency_, pitch_ * sizeof(float));
        pipe_.InitBuffer(trig_, 6 * rows_ * pitch_ * sizeof(float));
        // Two half-sized product arrays; raw float input remains read-only.
        pipe_.InitBuffer(values_, elements * sizeof(float));
    }
    __aicore__ inline void Process(float theta)
    {
        auto frequency = frequency_.Get<float>();
        if (Horner) RotaryStaticInitHorner(10000.0f, dim_, halfDim_, pitch_, frequency);
        else RotaryStaticInitBaseline(theta, dim_, halfDim_, pitch_, frequency);
        for (uint32_t i = halfDim_; i < pitch_; ++i) frequency.SetValue(i, 0.0f);
        Sync<AscendC::HardEvent::S_V>();
        for (uint64_t token = first_; token < last_; token += rows_) {
            const uint32_t rows = last_ - token < rows_ ? static_cast<uint32_t>(last_ - token) : rows_;
            const uint32_t trigCount = rows * pitch_;
            auto angles = trig_.Get<float>();
            auto cosine = angles[trigCount];
            auto sine = angles[2 * trigCount];
            auto turns = angles[3 * trigCount];
            auto temporary = angles[4 * trigCount];
            uint32_t zeros = 0;
            for (uint32_t row = 0; row < rows; ++row) {
                const int32_t position = positions_.GetValue(token + row);
                if (position == 0) zeros |= 1u << row;
                AscendC::Muls(angles[row * pitch_], frequency, static_cast<float>(position), pitch_);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, angles, 0.15915494309189535f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(temporary, temporary, 0.5f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(turns, temporary, AscendC::RoundMode::CAST_FLOOR, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 6.28125f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 0.001934051513671875f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temporary, turns, 0.0000012556659143567085f, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(angles, angles, temporary, trigCount);
            AscendC::PipeBarrier<PIPE_V>();
            RotaryPackedSdkTrig(cosine, sine, angles, trigCount);
            const uint32_t elements = rows * heads_ * dim_;
            const uint32_t pairs = elements / 2;
            const uint64_t offset = token * heads_ * dim_;
            AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(elements * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0, 0, static_cast<float>(0)};
            auto input = input_.template AllocTensor<float>();
            AscendC::DataCopyPad(input, x_[offset], copy, pad);
            input_.EnQue(input);
            input = input_.template DeQue<float>();
            auto output = output_.template AllocTensor<float>();
            auto productsBuffer = values_.Get<float>();
            auto positive = productsBuffer;
            auto negative = productsBuffer[pairs];
            auto values = input;
            if (heads_ == 1) {
                // Preserve both original H1 Adds(0) conversions, including signed zero.
                RotaryLoadFloat(output, input, elements);
                AscendC::PipeBarrier<PIPE_V>();
                values = output;
            }
            const uint8_t dataStride = static_cast<uint8_t>(heads_ * dim_ / 8);
            const uint8_t productStride = static_cast<uint8_t>(heads_ * halfDim_ / 8);
            const uint8_t trigStride = static_cast<uint8_t>(pitch_ / 8);
            AscendC::BinaryRepeatParams products{1, 1, 1, productStride, dataStride, trigStride};
            AscendC::BinaryRepeatParams multiply{1, 1, 1, dataStride, dataStride, trigStride};
            AscendC::BinaryRepeatParams add{1, 1, 1, dataStride, dataStride, productStride};
            for (uint32_t head = 0; head < heads_; ++head) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    const uint32_t data = head * dim_ + start;
                    const uint32_t product = head * halfDim_ + start;
                    AscendC::Mul(positive[product], values[data], sine[start], length,
                        static_cast<uint8_t>(rows), products);
                    AscendC::Mul(negative[product], values[data + halfDim_],
                        sine[start], length,
                        static_cast<uint8_t>(rows), products);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t head = 0; head < heads_; ++head) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    const uint32_t data = head * dim_ + start;
                    const uint32_t product = head * halfDim_ + start;
                    AscendC::Mul(output[data], values[data], cosine[start], length,
                        static_cast<uint8_t>(rows), multiply);
                    AscendC::Mul(output[data + halfDim_], values[data + halfDim_], cosine[start], length,
                        static_cast<uint8_t>(rows), multiply);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t head = 0; head < heads_; ++head) {
                for (uint32_t start = 0; start < halfDim_; start += 64) {
                    const uint64_t length = halfDim_ - start < 64 ? halfDim_ - start : 64;
                    const uint32_t data = head * dim_ + start;
                    const uint32_t product = head * halfDim_ + start;
                    AscendC::Sub(output[data], output[data], negative[product], length,
                        static_cast<uint8_t>(rows), add);
                    AscendC::Add(output[data + halfDim_], output[data + halfDim_], positive[product], length,
                        static_cast<uint8_t>(rows), add);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (heads_ == 1) {
                RotaryStoreFloat(output, output, elements);
                AscendC::PipeBarrier<PIPE_V>();
            }
            for (uint32_t row = 0; row < rows; ++row) {
                if (zeros & (1u << row)) {
                    const uint32_t begin = row * heads_ * dim_;
                    AscendC::DataCopy(output[begin], input[begin], heads_ * dim_);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            output_.EnQue(output);
            input_.FreeTensor(input);
            output = output_.template DeQue<float>();
            AscendC::DataCopyPad(y_[offset], output, copy);
            output_.FreeTensor(output);
        }
        Sync<AscendC::HardEvent::V_S>();
    }
private:
    template <AscendC::HardEvent event>
    __aicore__ inline void Sync()
    {
        int32_t id = static_cast<int32_t>(pipe_.FetchEventID(event));
        AscendC::SetFlag<event>(id); AscendC::WaitFlag<event>(id);
    }
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> output_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> frequency_, trig_, values_;
    AscendC::GlobalTensor<float> x_, y_;
    AscendC::GlobalTensor<int32_t> positions_;
    uint64_t first_, last_;
    uint32_t heads_, dim_, halfDim_, pitch_, rows_;
};

template <bool Horner>
__global__ __vector__ void rotary_float_token_window(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t rows, float theta)
{
    RotaryFloatTokenWindow<Horner> op;
    op.Init(x, positions, y, tokens, heads, dim, rows);
    op.Process(Horner ? 10000.0f : theta);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR positions,
    const TensorGroupInfo& info_positions, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, float theta)
{
    uint64_t tokenCount = static_cast<uint64_t>(info_x.tensors[0].shape[0]) * info_x.tensors[0].shape[1];
    uint32_t heads = static_cast<uint32_t>(info_x.tensors[0].shape[2]);
    uint32_t dim = static_cast<uint32_t>(info_x.tensors[0].shape[3]);
    uint32_t elementBytes = info_x.tensors[0].dtype == 1 ? 2 : 4;
    uint32_t tokensPerGroup = 1;
    while ((static_cast<uint64_t>(tokensPerGroup) * heads * dim * elementBytes) % 32 != 0) {
        ++tokensPerGroup;
    }
    uint64_t groups = (tokenCount + tokensPerGroup - 1) / tokensPerGroup;
    uint32_t blockNum = static_cast<uint32_t>(groups < static_cast<uint64_t>(availableCoreNum) ? groups : availableCoreNum);
    // Amortize vector and queue issue over complete, contiguous token rows.
    if (info_x.tensors[0].dtype == 1 && theta >= 1.0f && theta <= 1.0e8f &&
        (dim / 2) % 8 == 0 && heads * dim / 8 <= 255) {
        const uint32_t pitch = (dim / 2 + 15) / 16 * 16;
        // Both queues have two physical slots; reserve the original FP16 API margin.
        const uint32_t perRow = 16 * heads * dim + 20 * pitch;
        uint32_t rows = (192 * 1024 - 4 * pitch - 9216) / perRow;
        if (rows > 8) rows = 8;
        if (rows > tokenCount / blockNum) rows = static_cast<uint32_t>(tokenCount / blockNum);
        // H loops with R repeats replace R token loops with H repeats.
        if (rows >= 2 && rows > heads) {
            if (theta == 10000.0f) {
                rotary_half_token_window<true><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, rows, theta);
            } else {
                rotary_half_token_window<false><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, rows, theta);
            }
            return;
        }
    }
    // Amortize vector and queue issue over complete, contiguous token rows.
    if (info_x.tensors[0].dtype == 0 && theta >= 1.0f && theta <= 1.0e8f &&
        dim / 2 >= 64 && (dim / 2) % 8 == 0 && heads * dim / 8 <= 255) {
        const uint32_t pitch = (dim / 2 + 15) / 16 * 16;
        // Both queues have two physical slots; reserve the original reserved API margin.
        const uint32_t perRow = 20 * heads * dim + 24 * pitch;
        uint32_t rows = (192 * 1024 - 4 * pitch - 9216) / perRow;
        if (rows > 8) rows = 8;
        if (rows > tokenCount / blockNum) rows = static_cast<uint32_t>(tokenCount / blockNum);
        // H loops with R repeats replace R token loops with H repeats.
        if (rows >= 2 && rows > heads) {
            if (theta == 10000.0f) {
                rotary_float_token_window<true><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, rows, theta);
            } else {
                rotary_float_token_window<false><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, rows, theta);
            }
            return;
        }
    }
    uint32_t batchTokens = dim / 2 <= 128 ? 8 : (dim / 2 <= 256 ? 4 : 2);
    if (heads == 1 && info_x.tensors[0].dtype != 1 && theta == 10000.0f &&
        ((dim / 2) * elementBytes) % 32 == 0 && (tokenCount + blockNum - 1) / blockNum < batchTokens) {
        rotary_static_short<true><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
        return;
    }
    if (heads == 1) {
        if (theta == 10000.0f) {
            if (info_x.tensors[0].dtype == 1) {
                rotary_pos_emb_horner_isolated_single_head<half><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
            } else {
                rotary_pos_emb_horner_isolated_single_head<float><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
            }
        } else {
            if (info_x.tensors[0].dtype == 1) {
                rotary_pos_emb_custom_single_head<half><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
            } else {
                rotary_pos_emb_custom_single_head<float><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
            }
        }
        return;
    }
    if (theta == 10000.0f) {
        if (info_x.tensors[0].dtype == 1) {
            rotary_pos_emb_horner_isolated<half><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
        } else {
            rotary_pos_emb_horner_isolated<float><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
        }
        return;
    }
    if (info_x.tensors[0].dtype == 1) {
        rotary_pos_emb_custom<half><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
    } else {
        rotary_pos_emb_custom<float><<<blockNum, nullptr, stream>>>(x, positions, y, tokenCount, heads, dim, tokensPerGroup, theta);
    }
}
